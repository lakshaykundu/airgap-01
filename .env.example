# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Postgres. Leave empty to use embedded PGlite (local dev, tests, single-container Docker).
# On Vercel the Neon integration sets DATABASE_URL automatically.
DATABASE_URL=
# PGlite data directory (used only when DATABASE_URL is empty). Persist it in production.
DATABASE_PATH=./data/pgdata
# 'sse' streams live changes; 'poll' tells clients to poll (set automatically on Vercel).
REALTIME_MODE=sse
# Demo sessions untouched for this many days are deleted.
DEMO_SESSION_TTL_DAYS=7
# Max mutation requests per minute, per session.
MUTATION_RATE_LIMIT_PER_MINUTE=240
# New demo sessions per client IP per hour.
SESSION_RATE_LIMIT_PER_HOUR=30
# Directory containing the built web app (served in production).
WEB_DIST_PATH=../web/dist

# ── Web (public, compiled into the bundle — never put secrets here) ───────
VITE_APP_NAME=AIRGAP/01
VITE_SOURCE_URL=
VITE_GITHUB_URL=
VITE_PORTFOLIO_URL=
VITE_VIDEO_URL=
VITE_RESUME_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
